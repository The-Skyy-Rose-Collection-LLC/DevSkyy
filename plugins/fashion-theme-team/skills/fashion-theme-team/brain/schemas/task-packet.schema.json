{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyyrose.local/schemas/fashion-theme-task-packet.schema.json",
  "$comment": "SkyyRose LLC Fashion Theme Brain specialist task packet.",
  "title": "SkyyRose Fashion Theme Specialist Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["brand_contract", "phase_id", "mission", "owner", "candidate_id", "owned_paths", "exclusions", "inputs", "brain_routes", "deliverables", "approval_boundaries", "pass_conditions"],
  "properties": {
    "brand_contract": {"const": "brain/brand/skyyrose-artifact-system.json"},
    "phase_id": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "owned_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "brain_routes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "deliverables": {"type": "array", "minItems": 3, "contains": {"const": "preview.html"}, "items": {"type": "string"}},
    "approval_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pass_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
