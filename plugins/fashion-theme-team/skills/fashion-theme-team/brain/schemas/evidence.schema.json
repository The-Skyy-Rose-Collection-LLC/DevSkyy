{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyyrose.local/schemas/fashion-theme-evidence.schema.json",
  "$comment": "SkyyRose LLC Fashion Theme Brain candidate-bound evidence.",
  "title": "SkyyRose Fashion Theme Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brand_id", "candidate_id", "items", "verdict"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "brand_id": {"const": "skyyrose"},
    "candidate_id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "proof_class", "artifact", "reviewer", "result", "captured_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "claim": {"type": "string", "minLength": 1},
          "proof_class": {"enum": ["rendered-eyes-on", "executable", "authoritative-source", "experiment", "sot-provenance"]},
          "artifact": {"type": "string", "minLength": 1},
          "digest": {"type": "string"},
          "source_url": {"type": "string", "format": "uri"},
          "reviewer": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
          "captured_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]}
  }
}
