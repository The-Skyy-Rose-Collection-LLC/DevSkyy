includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - inc/
        - template-parts/
        - woocommerce/
        - patterns/
        - functions.php
        - front-page.php
        - template-collection-signature.php
        - template-collection-black-rose.php
        - template-collection-love-hurts.php
        - template-collection-kids-capsule.php
        - template-landing-black-rose.php
        - template-landing-love-hurts.php
        - template-landing-signature.php
        - template-preorder-gateway.php
        - template-about.php
        - template-collections-world.php
        - template-coming-soon.php
        - template-size-guide.php
        - template-elementor-canvas.php
        - template-elementor-fullwidth.php
        - template-elementor-editorial.php
        - template-faq.php
        - template-shipping-returns.php
        - template-contact.php
        - template-landing-kids-capsule.php
        - page-wishlist.php
        - page-collections.php
        - comments.php
        - archive.php
        - index.php
        - header.php
        - footer.php
        - sidebar.php
        - searchform.php
        - search.php
        - single.php
        - page.php
        - 404.php

    excludePaths:
        - vendor/
        # Optional: only present when npm deps are installed inside the theme.
        # Without (?) phpstan aborts before analysing anything.
        - node_modules/ (?)
        - tests/
        - blueprints/
        - docs/

    # scanFiles = symbol DISCOVERY (declares classes/functions/constants PHPStan
    # would otherwise call "not found"). stubFiles only OVERRIDES types of
    # symbols PHPStan already knows — it never makes WooCommerce discoverable.
    # Using stubFiles here was why WC_Product/wc_*() reported as unknown.
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
        - phpstan/constants.php
        - tests/stubs/wp-cli.php

    # These resolve to install-specific paths/URLs at runtime, so PHPStan must
    # not narrow them to the placeholder literals in phpstan/constants.php.
    dynamicConstantNames:
        - SKYYROSE_DIR
        - SKYYROSE_URI
        - COOKIEPATH
        - SKYYROSE_COMING_SOON_MODE

    ignoreErrors:
        # Elementor — optional integration, not present in analysis environment
        - '#.*(unknown class|invalid type|call to method .* on an unknown class) Elementor\\.*#'
